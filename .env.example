# Copy to .env.local and fill in. Never commit .env.local.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google PageSpeed Insights (optional — raises quota). Phase 3.
PAGESPEED_API_KEY=

# Stripe. Phase 5.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PRICE_ID=

# Resend. Phase 6.
RESEND_API_KEY=
REPORT_FROM_EMAIL=reports@sitekeep.com

# Cron auth (protects the daily report route). Phase 6.
CRON_SECRET=

# Google Analytics OAuth (traffic). Phase 3 — stubbed until provided.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
