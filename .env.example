# Copy to .env.local and fill in. Never commit .env.local.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google PageSpeed Insights (optional — raises quota). Phase 3.
PAGESPEED_API_KEY=

# Stripe. Phase 5.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PRICE_ID=

# Resend. Phase 6.
RESEND_API_KEY=
REPORT_FROM_EMAIL=reports@sitekeep.com

# Cron auth (protects the report + uptime cron routes; sent as
# `Authorization: Bearer <CRON_SECRET>` by the external scheduler). Phase 6/8.
CRON_SECRET=

# Google Analytics 4 (traffic). Service-account credential — the whole key file
# as base64-encoded JSON (recommended; base64 preserves the private_key
# newlines). Raw JSON is also accepted via GA4_SERVICE_ACCOUNT_JSON. Grant the
# service-account email Viewer on each client's GA4 property, then set the
# numeric Property ID per client in the traffic service settings. Without this,
# traffic shows labeled demo data. Phase 11.
#
# The SAME service account also powers Search Console (SEO): grant its email
# access under GSC → Settings → Users and permissions, then map a property URL
# per client. No separate key. Without it, Search Console shows "not connected".
GA4_SERVICE_ACCOUNT_KEY=
# GA4_SERVICE_ACCOUNT_JSON=

# Error monitoring (Sentry) — optional. Everything no-ops cleanly when unset.
# Same DSN value in both (server + client). Pre-launch hardening.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
